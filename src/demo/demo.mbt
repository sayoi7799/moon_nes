// A small homebrew NROM program, assembled at runtime. It prints some text
// and lets the player move a 16x16 moon sprite with the D-pad; holding A
// cycles the sprite palette and plays a DMC drum sample. A four-channel
// arrangement of the folk tune "Mary Had a Little Lamb" loops in the
// background. Being generated by this repository, it is covered by the
// repository license and can ship with the web demo.
//
// Zero page: $00 buttons (bit 7 = A ... bit 0 = Right), $01 x, $02 y,
// $03 color counter, $04 sprite attribute, $05 frames until the next song
// row, $06 song row. OAM buffer at $0200.

///|
/// 8x8 glyphs, '#' = color 1. Tiles are stored at their ASCII code so the
/// text is readable through `Nes::screen_text`.
let glyphs : Array[(Char, String)] = [
  ('A', ".###.... #...#... #...#... #####... #...#... #...#... #...#..."),
  ('B', "####.... #...#... #...#... ####.... #...#... #...#... ####...."),
  ('C', ".###.... #...#... #....... #....... #....... #...#... .###...."),
  ('D', "####.... #...#... #...#... #...#... #...#... #...#... ####...."),
  ('E', "#####... #....... #....... ####.... #....... #....... #####..."),
  ('I', ".###.... ..#..... ..#..... ..#..... ..#..... ..#..... .###...."),
  ('L', "#....... #....... #....... #....... #....... #....... #####..."),
  ('M', "#...#... ##.##... #.#.#... #.#.#... #...#... #...#... #...#..."),
  ('N', "#...#... ##..#... #.#.#... #..##... #...#... #...#... #...#..."),
  ('O', ".###.... #...#... #...#... #...#... #...#... #...#... .###...."),
  ('P', "####.... #...#... #...#... ####.... #....... #....... #......."),
  ('R', "####.... #...#... #...#... ####.... #.#..... #..#.... #...#..."),
  ('S', ".####... #....... #....... .###.... ....#... ....#... ####...."),
  ('T', "#####... ..#..... ..#..... ..#..... ..#..... ..#..... ..#....."),
  ('U', "#...#... #...#... #...#... #...#... #...#... #...#... .###...."),
  ('V', "#...#... #...#... #...#... #...#... #...#... .#.#.... ..#....."),
  (':', "........ ..#..... ..#..... ........ ..#..... ..#..... ........"),
  ('-', "........ ........ ........ .###.... ........ ........ ........"),
]

///|
/// 16x16 moon, split into tiles 1-4. Digits are color indices.
let moon : Array[String] = [
  ".....111111.....", "...1111111111...", "..111111111111..", ".11112211111111.",
  ".11122221111111.", "1111222111111111", "1111111111122111", "1111111111222211",
  "1111111111122111", "1111111111111111", "1112211111111111", ".11221111112211.",
  ".11111111112211.", "..111111111111..", "...1111111111...", ".....111111.....",
]

///|
/// Text lines: (PPU address, string).
let texts : Array[(Int32, String)] = [
  (0x210C, "MOON NES"),
  (0x2149, "A NES EMULATOR"),
  (0x216B, "IN MOONBIT"),
  (0x228A, "D-PAD: MOVE"),
  (0x22CC, "A: COLOR"),
]

///|
let palette : Array[Int32] = [
  0x0F, 0x30, 0x10, 0x00, 0x0F, 0x30, 0x10, 0x00, 0x0F, 0x30, 0x10, 0x00, 0x0F, 0x30,
  0x10, 0x00, 0x0F, 0x28, 0x18, 0x30, 0x0F, 0x2A, 0x1A, 0x30, 0x0F, 0x22, 0x12, 0x30,
  0x0F, 0x26, 0x16, 0x30,
]

///|
/// Song rows, 8 frames each. Pulse 1 plays the melody, pulse 2 a harmony,
/// the triangle the bass (an octave below the note), the noise channel a
/// kick and hi-hat. Note numbers index `period_lo`/`period_hi`; 0 keeps
/// the channel as it is. Noise values are $400E periods.
let song_p1 : Array[Int32] = [
  8, 7, 6, 7, 8, 8, 8, 0, 7, 7, 7, 0, 8, 9, 9, 0, 8, 7, 6, 7, 8, 8, 8, 8, 7, 7, 8,
  7, 6, 0, 0, 0,
]

///|
let song_p2 : Array[Int32] = [
  6, 5, 4, 5, 6, 6, 6, 0, 5, 5, 5, 0, 6, 8, 8, 0, 6, 5, 4, 5, 6, 6, 6, 6, 5, 5, 6,
  5, 3, 0, 0, 0,
]

///|
let song_triangle : Array[Int32] = [
  1, 0, 0, 0, 1, 0, 0, 0, 2, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 2, 0, 0,
  0, 1, 0, 0, 0,
]

///|
let song_noise : Array[Int32] = Array::makei(32, i => {
  if i % 4 == 0 {
    0x0C
  } else if i % 2 == 1 {
    0x03
  } else {
    0
  }
})

///|
/// NTSC pulse periods of C4, G3, G4, A4, B4, C5, D5, E5 and G5 (index 1-9),
/// from period = 1789773 / (16 f) - 1. The high byte carries length index 1
/// (254 half frames), so a note lasts until the next one.
let period_lo : Array[Int32] = [
  0, 0xAB, 0x3A, 0x1C, 0xFD, 0xE1, 0xD5, 0xBD, 0xA9, 0x8E,
]

///|
let period_hi : Array[Int32] = [0, 1, 2, 1, 0, 0, 0, 0, 0, 0].map(h => h | 0x08)

///|
/// DMC drum at $F000: alternating bytes of rising and falling deltas, a
/// triangle wave of 16 levels. At rate $A (142 cycles per bit) that is a
/// 790 Hz buzz lasting 33 bytes, about 1.3 frames.
let drum_sample : Array[Int32] = Array::makei(33, i => {
  if i % 2 == 0 {
    0xFF
  } else {
    0x00
  }
})

///|
/// Writes one 8x8 tile (rows of 2-bit color indices) into CHR memory.
fn put_tile(
  chr : FixedArray[Byte],
  tile : Int32,
  pixel : (Int32, Int32) -> Int32,
) -> Unit {
  for y in 0..<8 {
    let mut lo = 0
    let mut hi = 0
    for x in 0..<8 {
      let c = pixel(x, y)
      lo = lo | ((c & 1) << (7 - x))
      hi = hi | (((c >> 1) & 1) << (7 - x))
    }
    chr[tile * 16 + y] = lo.to_byte()
    chr[tile * 16 + 8 + y] = hi.to_byte()
  }
}

///|
fn build_chr() -> FixedArray[Byte] {
  let chr = FixedArray::make(8192, b'\x00')
  for entry in glyphs {
    let (ch, rows) = entry
    let lines = rows.split(" ").map(r => r.to_owned()).collect()
    put_tile(chr, ch.to_int(), (x, y) => {
      if y < lines.length() && lines[y].get_char(x) is Some('#') {
        1
      } else {
        0
      }
    })
  }
  for t in 0..<4 {
    let ox = t % 2 * 8
    let oy = t / 2 * 8
    put_tile(chr, 1 + t, (x, y) => {
      match moon[oy + y].get_char(ox + x) {
        Some('1') => 1
        Some('2') => 2
        _ => 0
      }
    })
  }
  chr
}

///|
fn build_program() -> Array[Int32] raise AsmError {
  let a = Asm::new(0xC000)
  // --- reset: init CPU and PPU, wait two frames for the PPU to warm up ---
  a.label("reset")
  a.op(0x78) // SEI
  a.op(0xD8) // CLD
  a.op8(0xA2, 0xFF) // LDX #$FF
  a.op(0x9A) // TXS
  a.op(0xE8) // INX            ; X = 0
  a.op16(0x8E, 0x2000) // STX $2000
  a.op16(0x8E, 0x2001) // STX $2001
  a.label("vwait1")
  a.op16(0x2C, 0x2002) // BIT $2002
  a.branch(0x10, "vwait1") // BPL
  a.label("vwait2")
  a.op16(0x2C, 0x2002)
  a.branch(0x10, "vwait2")
  // Hide all sprites in the OAM buffer.
  a.op8(0xA9, 0xFF) // LDA #$FF
  a.label("clear_oam")
  a.op16(0x9D, 0x0200) // STA $0200,X
  a.op(0xE8) // INX
  a.branch(0xD0, "clear_oam") // BNE
  // Palette.
  a.op8(0xA9, 0x3F)
  a.op16(0x8D, 0x2006) // STA $2006
  a.op16(0x8E, 0x2006) // STX $2006   ; X = 0
  a.label("load_palette")
  a.op_label(0xBD, "palette") // LDA palette,X
  a.op16(0x8D, 0x2007) // STA $2007
  a.op(0xE8)
  a.op8(0xE0, 0x20) // CPX #$20
  a.branch(0xD0, "load_palette")
  // Clear nametable 0 and its attributes (1 KiB of zeros).
  a.op8(0xA9, 0x20)
  a.op16(0x8D, 0x2006)
  a.op8(0xA9, 0x00)
  a.op16(0x8D, 0x2006)
  a.op8(0xA0, 0x04) // LDY #4
  a.label("clear_nt")
  a.op16(0x8D, 0x2007)
  a.op(0xE8)
  a.branch(0xD0, "clear_nt")
  a.op(0x88) // DEY
  a.branch(0xD0, "clear_nt")
  // Text: records of (hi, lo, chars..., 0), ended by $FF.
  a.label("next_string")
  a.op_label(0xBD, "texts") // LDA texts,X
  a.op8(0xC9, 0xFF) // CMP #$FF
  a.branch(0xF0, "text_done") // BEQ
  a.op16(0x8D, 0x2006)
  a.op(0xE8)
  a.op_label(0xBD, "texts")
  a.op16(0x8D, 0x2006)
  a.op(0xE8)
  a.label("next_char")
  a.op_label(0xBD, "texts")
  a.op(0xE8)
  a.op8(0xC9, 0x00) // CMP #0
  a.branch(0xF0, "next_string")
  a.op16(0x8D, 0x2007)
  a.op_label(0x4C, "next_char") // JMP
  a.label("text_done")
  // Sound: pulses, triangle and noise on, sweeps off, frame IRQ off, the
  // DMC set up for the drum sample at $F000 (33 bytes).
  for
    write in [
      (0x0F, 0x4015),
      (0x40, 0x4017),
      (0x08, 0x4001),
      (0x08, 0x4005),
      (0x0A, 0x4010),
      (0xC0, 0x4012),
      (0x02, 0x4013),
      (0x00, 0x0005),
      (0x00, 0x0006),
    ] {
    let (value, addr) = write
    a.op8(0xA9, value) // LDA #value
    a.op16(0x8D, addr) // STA addr
  }
  // Start position and rendering.
  a.op8(0xA9, 120)
  a.op8(0x85, 0x01) // STA $01
  a.op8(0x85, 0x02) // STA $02
  a.op8(0xA9, 0x80)
  a.op16(0x8D, 0x2000) // NMI on
  a.op8(0xA9, 0x1E)
  a.op16(0x8D, 0x2001) // background + sprites, no clipping
  a.label("forever")
  a.op_label(0x4C, "forever")
  // --- NMI: read the pad, move the moon, upload sprites ---
  a.label("nmi")
  a.op(0x48) // PHA
  a.op8(0xA9, 0x01)
  a.op16(0x8D, 0x4016) // strobe
  a.op8(0xA9, 0x00)
  a.op16(0x8D, 0x4016)
  a.op8(0xA2, 0x08) // LDX #8
  a.label("read_pad")
  a.op16(0xAD, 0x4016) // LDA $4016
  a.op(0x4A) // LSR A
  a.op8(0x26, 0x00) // ROL $00
  a.op(0xCA) // DEX
  a.branch(0xD0, "read_pad")
  for
    step in [
      (0x01, 0xE6, 0x01),
      (0x02, 0xC6, 0x01),
      (0x04, 0xE6, 0x02),
      (0x08, 0xC6, 0x02),
    ] {
    // (button bit, INC/DEC opcode, zero page variable)
    let (bit, opcode, zp_var) = step
    let skip = "skip_\{bit}"
    a.op8(0xA5, 0x00) // LDA $00
    a.op8(0x29, bit) // AND #bit
    a.branch(0xF0, skip) // BEQ
    a.op8(opcode, zp_var)
    a.label(skip)
  }
  a.op8(0xA5, 0x00)
  a.op8(0x29, 0x80) // A button
  a.branch(0xF0, "no_color")
  // Start the drum unless it is still playing ($4015 bit 4).
  a.op16(0xAD, 0x4015) // LDA $4015
  a.op8(0x29, 0x10)
  a.branch(0xD0, "drum_busy") // BNE
  a.op8(0xA9, 0x1F)
  a.op16(0x8D, 0x4015)
  a.label("drum_busy")
  a.op8(0xE6, 0x03) // INC $03
  a.label("no_color")
  a.op8(0xA5, 0x03)
  a.op(0x4A)
  a.op(0x4A)
  a.op(0x4A)
  a.op8(0x29, 0x03)
  a.op8(0x85, 0x04) // attribute = (counter >> 3) & 3
  // Four sprites in a 2x2 square: Y at +0, X at +3 of each OAM entry.
  a.op8(0xA5, 0x02)
  a.op16(0x8D, 0x0200)
  a.op16(0x8D, 0x0204)
  a.op(0x18) // CLC
  a.op8(0x69, 0x08) // ADC #8
  a.op16(0x8D, 0x0208)
  a.op16(0x8D, 0x020C)
  a.op8(0xA5, 0x01)
  a.op16(0x8D, 0x0203)
  a.op16(0x8D, 0x020B)
  a.op(0x18)
  a.op8(0x69, 0x08)
  a.op16(0x8D, 0x0207)
  a.op16(0x8D, 0x020F)
  for i in 0..<4 {
    a.op8(0xA9, i + 1)
    a.op16(0x8D, 0x0201 + i * 4) // tile
    a.op8(0xA5, 0x04)
    a.op16(0x8D, 0x0202 + i * 4) // attribute
  }
  a.op8(0xA9, 0x00)
  a.op16(0x8D, 0x2003) // OAMADDR = 0
  a.op8(0xA9, 0x02)
  a.op16(0x8D, 0x4014) // DMA from $0200
  a.op8(0xA9, 0x00)
  a.op16(0x8D, 0x2005) // scroll 0,0
  a.op16(0x8D, 0x2005)
  // Music: every 8 frames, play the next song row.
  a.op8(0xC6, 0x05) // DEC $05
  a.branch(0x10, "music_done") // BPL
  a.op8(0xA9, 0x07)
  a.op8(0x85, 0x05)
  a.op8(0xA6, 0x06) // LDX $06
  for
    channel in [
      ("song_p1", 0x83, 0x4000), // 50% duty, decaying envelope
      ("song_p2", 0x55, 0x4004), // 25% duty, constant volume 5
      ("song_triangle", 0x30, 0x4008), // linear counter: 48 quarter frames
    ] {
    let (table, control, base) = channel
    let skip = "skip_" + table
    a.op_label(0xBC, table) // LDY table,X
    a.branch(0xF0, skip) // BEQ
    a.op8(0xA9, control)
    a.op16(0x8D, base)
    a.op_label(0xB9, "period_lo") // LDA period_lo,Y
    a.op16(0x8D, base + 2)
    a.op_label(0xB9, "period_hi")
    a.op16(0x8D, base + 3)
    a.label(skip)
  }
  a.op_label(0xBD, "song_noise") // LDA song_noise,X
  a.branch(0xF0, "skip_noise")
  a.op16(0x8D, 0x400E)
  a.op8(0xA9, 0x01) // short decaying envelope
  a.op16(0x8D, 0x400C)
  a.op8(0xA9, 0x08)
  a.op16(0x8D, 0x400F)
  a.label("skip_noise")
  a.op(0xE8) // INX
  a.op8(0xE0, song_p1.length()) // CPX #rows
  a.branch(0xD0, "same_loop")
  a.op8(0xA2, 0x00)
  a.label("same_loop")
  a.op8(0x86, 0x06) // STX $06
  a.label("music_done")
  a.op8(0xA9, 0x80)
  a.op16(0x8D, 0x2000)
  a.op(0x68) // PLA
  a.label("irq")
  a.op(0x40) // RTI
  // --- data ---
  a.label("palette")
  a.bytes(palette)
  a.label("texts")
  for line in texts {
    let (addr, s) = line
    a.bytes([addr >> 8, addr & 0xFF])
    for c in s {
      a.bytes([c.to_int()])
    }
    a.bytes([0])
  }
  a.bytes([0xFF])
  for
    table in [
      ("song_p1", song_p1),
      ("song_p2", song_p2),
      ("song_triangle", song_triangle),
      ("song_noise", song_noise),
      ("period_lo", period_lo),
      ("period_hi", period_hi),
    ] {
    let (name, data) = table
    a.label(name)
    a.bytes(data)
  }
  let code = a.link()
  // Vectors live at the end of the 16 KiB bank ($FFFA).
  let prg = Array::make(0x4000, 0xFF)
  for i, b in code {
    prg[i] = b
  }
  // The DMC reads samples from $C000 + n * 64; the drum sits at $F000.
  for i, b in drum_sample {
    prg[0x3000 + i] = b
  }
  let nmi = a.address_of("nmi")
  let reset = a.address_of("reset")
  let irq = a.address_of("irq")
  for i, v in [nmi, reset, irq] {
    prg[0x3FFA + i * 2] = v & 0xFF
    prg[0x3FFB + i * 2] = v >> 8
  }
  prg
}

///|
/// The demo as an iNES image (NROM-128, vertical mirroring).
pub fn demo_rom() -> Bytes {
  let prg = build_program() catch {
    e => abort("demo assembly failed: " + e.message())
  }
  let chr = build_chr()
  let header = [0x4E, 0x45, 0x53, 0x1A, 1, 1, 0x01, 0, 0, 0, 0, 0, 0, 0, 0, 0]
  Bytes::makei(16 + prg.length() + chr.length(), i => {
    if i < 16 {
      header[i].to_byte()
    } else if i < 16 + prg.length() {
      prg[i - 16].to_byte()
    } else {
      chr[i - 16 - prg.length()]
    }
  })
}
